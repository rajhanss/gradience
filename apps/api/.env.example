# Gradience API Environment Configuration Example

# FortyGuard API Credentials (Required for live satellite heatmap scans)
# Get from: https://dashboard.fortyguard.com/keys
# Note: Sandbox/staging key has reduced credits (2M)
FORTYGUARD_API_KEY=your_api_key_here

# Groq API Credentials (Optional - LLM-powered assistant fallback works without it)
# Get from: https://console.groq.com
# Model: llama-3.3-70b-versatile
# Without key: chatbot uses hardcoded reference answers
GROQ_API_KEY=your_groq_key_here

# Perplexity API Credentials (Optional - climate intelligence search lookup)
PERPLEXITY_API_KEY=your_perplexity_key_here

# CORS Configuration (Comma-separated URLs, e.g. http://localhost:3000,https://gradience-web-production.up.railway.app)
# When set: enables credentialed requests for specified origins
# When unset: defaults to wildcard origin with allow_credentials=False for browser security
GRADIENCE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development  # development | staging | production
