# Gradience Environment Variables Example

# FortyGuard API key for live thermal satellite heatmaps (pilot cities: Phoenix, Las Vegas, Houston)
FORTYGUARD_API_KEY=

# Groq API key for LLM-powered urban climate assistant (optional - falls back to compiled reference model)
GROQ_API_KEY=

# Perplexity API key for climate intelligence lookup (optional)
PERPLEXITY_API_KEY=

# Allowed CORS origins (comma-separated URLs, e.g. https://gradience-web-production.up.railway.app)
GRADIENCE_CORS_ORIGINS=
