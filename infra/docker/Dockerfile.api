FROM python:3.12-slim

WORKDIR /app

COPY packages/city-domain packages/city-domain
COPY packages/thermal-providers packages/thermal-providers
COPY apps/api apps/api

RUN pip install --no-cache-dir \
    ./packages/city-domain \
    ./packages/thermal-providers \
    ./apps/api \
    "httpx>=0.27"

ENV PYTHONPATH=/app/apps/api/src
EXPOSE 8000

CMD ["sh", "-c", "uvicorn gradience_api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
